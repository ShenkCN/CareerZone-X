{
  "manifest_version": 3,
  "name": "CareerZone X 采集器",
  "version": "0.4.1",
  "description": "用户浏览职位页时，点击或按开关补全当前可见 JD；不自动翻页、不登录、不绕验证码。",
  "permissions": ["activeTab", "scripting", "storage", "cookies"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8501/*",
    "http://localhost:8501/*",
    "http://1.95.10.89/*",
    "http://1.95.10.89:8000/*",
    "https://*.zhipin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集当前页到 CareerZone X"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/web/geek/jobs*", "https://www.zhipin.com/job_detail/*"],
      "js": ["auto_detail.js"],
      "run_at": "document_idle"
    }
  ]
}
