# ============================================================
# 复制为 .env 后填写；不要提交真实 .env。
# 管理员初始密码/密保答案只在首次建库时读取，之后数据库里只存哈希。
# ============================================================
APP_NAME=CareerZone X
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# 用随机 64 位十六进制；泄露后所有登录会话失效。
APP_SECRET_KEY=replace-with-openssl-rand-hex-32
API_BASE_URL=http://127.0.0.1:8000

# 本机推荐 MySQL 8；没有 MySQL 时可临时改成 sqlite:///./storage/careerzone.db。
DATABASE_URL=mysql+pymysql://careerzone:replace-password@127.0.0.1:3306/careerzone_x?charset=utf8mb4
DB_ECHO=false

# DeepSeek Key 只放这里，代码永远不硬编码。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_ENABLED=true

# 向量检索；首次会下载中文 embedding 模型。
VECTOR_ENABLED=true
# true=尝试加载 bge；本机若拦截 torch/regex DLL，建议 false，自动用 hash-384。
VECTOR_TRY_MODEL=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHROMA_DIR=storage/chroma

# 管理员首次建库凭据；管理员密码固定不可修改。
ADMIN_USERNAME=Shenk
ADMIN_INITIAL_PASSWORD=replace-with-strong-password
ADMIN_SECURITY_QUESTION=CareerZone X 安装时生成的 8 位管理员暗号是什么？
ADMIN_INITIAL_ANSWER=replace-with-8-char-answer

# 本机 Streamlit 与浏览器扩展来源。
ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:8000,http://localhost:8000

# 上传/登录/会话限制。
MAX_RESUME_MB=10
MAX_AVATAR_MB=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_HOURS_USER=12
SESSION_HOURS_ADMIN=4
IMPORT_MAX_JOBS=1000
# 本机自用可 false（扩展不用令牌）；公网必须 true。
IMPORT_TOKEN_REQUIRED=false
# 公网/多用户建议 true：扩展必须带登录 Cookie；本机可 false。
IMPORT_REQUIRE_SESSION=false

# 官方 API 预留（没有授权就保持 false；配置后管理员接口才会工作）
OFFICIAL_API_ENABLED=false
OFFICIAL_API_BASE_URL=
OFFICIAL_API_KEY=
OFFICIAL_API_TIMEOUT=30

# 费用估算单价（元/百万 token）；0 表示只统计 token、不估算金额。
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
